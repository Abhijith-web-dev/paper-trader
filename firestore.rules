rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // 1. User Root Document & Profile
    // -------------------------------------------------------------
    match /users/{userId} {
      // User can read and write only their own account document
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.profile.fullName is string
                    && request.resource.data.profile.fullName.size() > 0;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // -----------------------------------------------------------
      // 2. Wallets Subcollection (Virtual Capital Integrity)
      // -----------------------------------------------------------
      match /wallets/{walletId} {
        allow read: if isOwner(userId);
        // Ensure cash balance cannot be negative
        allow write: if isOwner(userId)
                     && request.resource.data.cashBalance is number
                     && request.resource.data.cashBalance >= 0;
      }

      // -----------------------------------------------------------
      // 3. Stock Holdings Subcollection (Active Portfolio)
      // -----------------------------------------------------------
      match /holdings/{holdingId} {
        allow read: if isOwner(userId);
        // Quantity must be a valid positive number
        allow create, update: if isOwner(userId)
                              && request.resource.data.quantity is number
                              && request.resource.data.quantity >= 0
                              && request.resource.data.symbol is string;
        allow delete: if isOwner(userId);
      }

      // -----------------------------------------------------------
      // 4. Orders Ledger Subcollection (Immutable Trade Audit Trail)
      // -----------------------------------------------------------
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        // New trade orders can be created if validated
        allow create: if isOwner(userId)
                      && request.resource.data.symbol is string
                      && request.resource.data.action in ['BUY', 'SELL']
                      && request.resource.data.quantity is number
                      && request.resource.data.quantity > 0
                      && request.resource.data.price is number
                      && request.resource.data.price > 0;
        // Trade records are an immutable financial ledger (cannot be altered or erased)
        allow update, delete: if false;
      }

      // -----------------------------------------------------------
      // 5. Account Transactions & Cash Ledger Logs
      // -----------------------------------------------------------
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false; // Immutable audit log
      }
    }

    // -------------------------------------------------------------
    // 6. Market Metadata, Holiday Schedules & Exchange Clocks
    // -------------------------------------------------------------
    match /market_metadata/{document=**} {
      // Publicly readable so unauthenticated landing pages & tickers can display schedules
      allow read: if true;
      // Writable only by administrative backend service accounts
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 7. Global Stock Quotes Cache
    // -------------------------------------------------------------
    match /quotes/{symbol} {
      allow read: if true;
      allow write: if false;
    }
  }
}
