# GlobalTrade Simulator - Environment Configuration Template

# Server & Network
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
MARKET_WORKER_PORT=4001

# Application Settings
APP_NAME="GlobalTrade Simulator"
DEFAULT_STARTING_BALANCE=100000
DEFAULT_BASE_CURRENCY=USD
FEATURE_FLAG_CRYPTO_ENABLED=true
FEATURE_FLAG_INDIAN_MARKET_ENABLED=true
FEATURE_FLAG_FOREX_ENABLED=true
FEATURE_FLAG_BACKTESTING_ENABLED=true

# Firebase (Authentication & Primary Firestore Database)
# In development, leave these blank or default to use built-in simulated mock mode
FIREBASE_PROJECT_ID=globaltrade-simulator-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@globaltrade-simulator-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Web Client Firebase Configuration (Public)
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=globaltrade-simulator-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=globaltrade-simulator-demo
VITE_FIREBASE_STORAGE_BUCKET=globaltrade-simulator-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Supabase (Storage Buckets for Media, Avatars & Learning Materials)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# Public Supabase Settings (Web Client)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Market Data Providers Configuration
# Yahoo Finance is the primary real-market provider (No key required for base endpoints)
YAHOO_FINANCE_ENABLED=true
YAHOO_FINANCE_CACHE_TTL_SECONDS=5

# Frankfurter API (European Central Bank FX Rates - Free, Real-Time, No API Key needed)
FRANKFURTER_ENABLED=true
FRANKFURTER_CACHE_TTL_SECONDS=60

# CoinGecko API (Cryptocurrency Rates)
COINGECKO_API_KEY=
COINGECKO_CACHE_TTL_SECONDS=15

# Optional Pluggable Market Providers
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
